{
  "expo": {
    "name": "QRShield",
    "slug": "qrshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qrshield",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060a12",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060a12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qrshield.pro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060a12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "package": "com.qrshield.pro",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "QRShield needs camera access to scan QR codes for threat analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
